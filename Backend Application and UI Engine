@app.post("/api/predict", response_model=Prediction)
def predict(payload: PredictRequest):
    m = MODEL
    if m is None:
        return Prediction(label=None, confidence=0.0, status="model_unavailable",
                          message="No model trained yet.")
    try:
        kin = analyze_kinematics(payload.landmarks, payload.sequence)
        x = features(payload.landmarks).reshape(1, -1)
        x_mirrored = x.copy()
        for idx in range(0, 63, 3):
            x_mirrored[0, idx] = -x_mirrored[0, idx]

        X_train = m["clf"]._fit_X
        y_labels = m["clf"].classes_[m["clf"]._y]

        ext = kin["finger_states"]
        m_type = kin.get("motion_type", "static")
        hand_y = kin.get("hand_y", 0.5)

        # Multi-factor Closeness Engine across all 22 ISL signs
        candidate_scores = {}
        for s in ISL_101_DICTIONARY.keys():
            class_indices = np.where(y_labels == s)[0]
            if len(class_indices) == 0:
                continue
            samples = X_train[class_indices]
            d_orig = float(np.linalg.norm(samples - x, axis=1).min())
            d_mirr = float(np.linalg.norm(samples - x_mirrored, axis=1).min())
            min_dist = min(d_orig, d_mirr)

            # 1. 3D Shape Proximity
            shape_sim = 1.0 / (1.0 + min_dist * 0.75)

            # 2. Finger Flexion Compatibility
            rule = SIGN_RULES.get(s, {})
            req_f = rule.get("fingers", [None] * 5)
            mismatches, checked = 0, 0
            for u_f, r_f in zip(ext, req_f):
                if r_f is not None:
                    checked += 1
                    if bool(u_f) != bool(r_f):
                        mismatches += 1
            finger_sim = 1.0 - (mismatches / max(checked, 1))

            # 3. Dynamic Motion & Position Compatibility
            motion_bonus = 0.0
            req_m = rule.get("motion", "any")
            if req_m != "any":
                if req_m == m_type:
                    motion_bonus += 0.08
                elif m_type != "static" and req_m in ["wave", "shake", "circle", "nod", "lift"]:
                    motion_bonus += 0.04
                elif m_type == "static" and req_m == "static":
                    motion_bonus += 0.06

            if s == "Father" and hand_y < 0.38:
                motion_bonus += 0.08
            elif s == "Mother" and 0.40 <= hand_y <= 0.65:
                motion_bonus += 0.06

            score = (0.50 * shape_sim) + (0.42 * finger_sim) + motion_bonus
            candidate_scores[s] = (score, min_dist)

    except Exception as exc:
        raise HTTPException(status_code=503, detail="Recognition error.") from exc

    ranked = sorted(candidate_scores.items(), key=lambda kv: kv[1][0], reverse=True)
    if not ranked:
        return Prediction(label=None, confidence=0.0, status="outlier",
                          message="No recognizable hand sign detected.")

    best_sign, (best_score, best_dist) = ranked[0]
    best_meta = ISL_101_DICTIONARY.get(best_sign, {})

    closest_matches = []
    for s_name, (sc, dist_val) in ranked[:3]:
        s_meta = ISL_101_DICTIONARY.get(s_name, {})
        pct = int(np.clip(sc * 105, 15, 99))
        closest_matches.append(ClosestMatch(
            sign=s_name,
            similarity=pct,
            meaning=s_meta.get("meaning", s_name),
            hindi=s_meta.get("hindi", ""),
            icon=s_meta.get("icon", "✋"),
            type=s_meta.get("type", "Static / Dynamic")
        ))

    conf = float(np.clip(best_score * 0.98, 0.40, 0.99))
    is_solid = (conf >= MIN_CONFIDENCE and best_dist <= 2.80)
    status_str = "recognized" if is_solid else "interpreting"

    return Prediction(
        label=best_sign,
        confidence=conf,
        status=status_str,
        message="Sign interpreted successfully.",
        meaning=best_meta.get("meaning", best_sign),
        hindi=best_meta.get("hindi", ""),
        desc=best_meta.get("desc", ""),
        description=best_meta.get("desc", ""),
        category=best_meta.get("category", "General"),
        icon=best_meta.get("icon", "✋"),
        gesture_type=best_meta.get("type", "Static / Dynamic"),
        motion_state=kin["motion_state"],
        speed_px=kin["speed_px"],
        finger_summary=kin["finger_summary"],
        closest_matches=closest_matches
    )


