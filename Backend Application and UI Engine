# ---------- Storage & Model Loading ----------
def db():
    con = sqlite3.connect(DB_PATH)
    con.execute("CREATE TABLE IF NOT EXISTS samples (id INTEGER PRIMARY KEY, label TEXT NOT NULL, f TEXT NOT NULL)")
    return con


def counts() -> dict:
    with db() as con:
        return dict(con.execute("SELECT label, COUNT(*) FROM samples GROUP BY label").fetchall())


