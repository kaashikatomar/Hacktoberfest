# ---------- Pydantic Data Models ----------
class Landmark(BaseModel):
    x: float
    y: float
    z: float


Hand = Annotated[list[Landmark], Field(min_length=21, max_length=21)]


class PredictRequest(BaseModel):
    landmarks: Hand
    sequence: Optional[list[Hand]] = None


class SampleBatch(BaseModel):
    label: str = Field(min_length=1, max_length=40)
    samples: list[Hand] = Field(min_length=1, max_length=200)


class ClosestMatch(BaseModel):
    sign: str
    similarity: int  # 0 to 100%
    meaning: str
    hindi: str
    icon: str
    type: str


class Prediction(BaseModel):
    label: Optional[str] = None
    confidence: float = Field(ge=0.0, le=1.0)
    status: str
    message: str
    meaning: Optional[str] = None
    hindi: Optional[str] = None
    desc: Optional[str] = None
    description: Optional[str] = None
    category: Optional[str] = None
    icon: Optional[str] = None
    gesture_type: Optional[str] = None
    motion_state: Optional[str] = None
    speed_px: Optional[float] = None
    finger_summary: Optional[str] = None
    closest_matches: list[ClosestMatch] = []


# ---------- Features & Kinematic Engine ----------
def features(hand) -> np.ndarray:
    """Wrist-centred, scale-normalised 63-D vector."""
    a = np.array([[p.x, p.y, p.z] for p in hand], dtype=float)
    a -= a[0]
    scale = np.linalg.norm(a[:, :2], axis=1).max()
    if scale < 1e-6:
        raise ValueError("Degenerate hand landmarks.")
    return (a / scale).flatten()


def analyze_kinematics(landmarks, sequence=None):
    """Computes robust anatomical finger flexion states and movement dynamics."""
    raw = np.array([[p.x, p.y, p.z] for p in landmarks], dtype=float)
    wrist = raw[0]
    palm_len = max(np.linalg.norm(raw[9] - wrist), 1e-4)

    # Anatomical finger extension check
    dist_thumb_pinky = np.linalg.norm(raw[4] - raw[17]) / palm_len
    dist_thumb_ext = np.linalg.norm(raw[4] - raw[2]) / palm_len
    thumb_is_open = bool(dist_thumb_pinky > 1.12 and dist_thumb_ext > 0.62)

    finger_indices = [(8, 6, 5), (12, 10, 9), (16, 14, 13), (20, 18, 17)]
    ext_states = [thumb_is_open]
    for tip, pip, mcp in finger_indices:
        d_tip_wrist = np.linalg.norm(raw[tip] - wrist)
        d_pip_wrist = np.linalg.norm(raw[pip] - wrist)
        d_tip_mcp = np.linalg.norm(raw[tip] - raw[mcp])
        d_pip_mcp = np.linalg.norm(raw[pip] - raw[mcp])
        is_open = (d_tip_wrist > d_pip_wrist * 1.08) and (d_tip_mcp > d_pip_mcp * 1.15)
        ext_states.append(bool(is_open))

    open_fingers = []
    names = ["Thumb", "Index", "Middle", "Ring", "Pinky"]
    for i, ext in enumerate(ext_states):
        if ext:
            open_fingers.append(names[i])
    finger_summary = ", ".join(open_fingers) + " OPEN" if open_fingers else "All Fingers CURLED (Fist)"

    # Movement trajectory analysis
    is_moving = False
    motion_state = "Stationary / Holding"
    motion_type = "static"
    speed_px = 0.0

    if sequence and len(sequence) >= 2:
        seq_raw = np.array([[[p.x, p.y, p.z] for p in f] for f in sequence], dtype=float)
        wrists = seq_raw[:, 0, :]
        diffs = np.diff(wrists, axis=0)
        speeds = np.linalg.norm(diffs, axis=-1)
        speed_px = float(speeds.mean() * 1000)

        disp = wrists[-1] - wrists[0]
        total_travel = float(np.linalg.norm(disp))

        if speed_px > 12.0 or total_travel > 0.05:
            is_moving = True
            dx, dy, dz = disp[0], disp[1], disp[2]
            abs_x, abs_y, abs_z = abs(dx), abs(dy), abs(dz)
            if abs_z > abs_x and abs_z > abs_y and abs_z > 0.035:
                motion_state = "Forward Trajectory ↗" if dz > 0 else "Inward Sweep ↙"
                motion_type = "forward" if dz > 0 else "inward"
            elif abs_y > abs_x and abs_y > 0.035:
                motion_state = "Upward Lift ↑" if dy < 0 else "Downward Motion ↓"
                motion_type = "lift" if dy < 0 else "down"
            elif abs_x > 0.035:
                motion_state = "Horizontal Sweep ↔"
                motion_type = "wave"
            elif speed_px > 18.0:
                motion_state = "Oscillating / Shaking ↔"
                motion_type = "shake"
            else:
                motion_state = "Fingertip Motion / Tapping 👆"
                motion_type = "tap"

    return {
        "finger_states": ext_states,
        "finger_summary": finger_summary,
        "is_moving": is_moving,
        "motion_state": motion_state,
        "motion_type": motion_type,
        "speed_px": round(speed_px, 1),
        "hand_y": float(raw[:, 1].mean())
    }


