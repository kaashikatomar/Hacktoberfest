from pathlib import Path
from typing import Optional
import os
from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, Field, field_validator
BASE_DIR = Path(__file__).resolve().parent.parent
STATIC_DIR = BASE_DIR / "static"
VOCAB = [
"Help", "Water", "Doctor", "Medicine", "Money",
"Thank you", "Yes", "No", "Please", "Wait",
]
MIN_CONFIDENCE = float(os.getenv("SIGNSPEAK_MIN_CONFIDENCE", "0.70"))
app = FastAPI(
title="SignSpeak ISL API",
version="0.1.0",
description="Backend API for a Sign-to-Speech Translator prototype.",
)
if STATIC_DIR.exists():
app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")
class Landmark(BaseModel):
x: float = Field(ge=0.0, le=1.0)
y: float = Field(ge=0.0, le=1.0)
z: float = Field(ge=-10.0, le=10.0)
class PredictRequest(BaseModel):
landmarks: list[Landmark] = Field(min_length=21, max_length=21)
class Prediction(BaseModel):
label: Optional[str] = None
confidence: float = Field(ge=0.0, le=1.0)
status: str
message: str
class DemoRequest(BaseModel):
label: str
confidence: float = Field(default=0.9, ge=0.0, le=1.0)
@field_validator("label")
@classmethod
def validate_label(cls, value: str) -> str:
if value not in VOCAB:
raise ValueError("Label must be from the supported demo vocabulary.")
return value
def get_model():
return None
"""Replace with a trained model exposing predict(landmarks) -> (label, confidence)."""
MODEL = get_model()
@app.get("/")
def home():
index_file = STATIC_DIR / "index.html"
if not index_file.is_file():
raise HTTPException(status_code=404, detail="Frontend static/index.html was not found.")
return FileResponse(index_file)
@app.get("/api/health")
def health():
return {
"status": "ok",
"service": "signspeak-isl",
"model_loaded": MODEL is not None,
"recognition_available": MODEL is not None,
"min_confidence": MIN_CONFIDENCE,
}

@app.get("/api/vocab")
def vocabulary():
return {
"items": VOCAB,
"validated_for_isl": False,
"note": "Placeholder vocabulary; validate signs and labels with fluent ISL signers.",
}
@app.post("/api/predict", response_model=Prediction)
def predict(payload: PredictRequest):
if MODEL is None:
return Prediction(
label=None,
confidence=0.0,
status="model_unavailable",
message="No trained ISL model is installed. Use manual text or the demo endpoint.",
)
try:
landmarks = [point.model_dump() for point in payload.landmarks]
label, confidence = MODEL.predict(landmarks)
confidence = max(0.0, min(1.0, float(confidence)))
if label not in VOCAB or confidence < MIN_CONFIDENCE:
return Prediction(
label=None,
confidence=confidence,
status="not_sure",
message="Prediction uncertain. Repeat the sign or enter text manually.",
)
return Prediction(
label=label,
confidence=confidence,
status="recognized",
message="Review the recognized text before speaking.",
)
except Exception as exc:
raise HTTPException(status_code=503, detail="Recognition failed. Please try again.") from exc
@app.post("/api/demo/predict", response_model=Prediction)
def demo_predict(payload: DemoRequest):
return Prediction(
label=payload.label,
confidence=payload.confidence,
status="demo_only",
message="SIMULATED result — this is not actual ISL recognition.",
)

from fastapi.testclient import TestClient
from app.main import app
client = TestClient(app)
def test_health():
response = client.get("/api/health")
assert response.status_code == 200
assert response.json()["status"] == "ok"
def test_vocabulary():
response = client.get("/api/vocab")
assert response.status_code == 200
assert "Help" in response.json()["items"]
def test_predict_without_model():
landmarks = [{"x": 0.5, "y": 0.5, "z": 0.0} for _ in range(21)]
response = client.post("/api/predict", json={"landmarks": landmarks})
assert response.status_code == 200
assert response.json()["status"] == "model_unavailable"
def test_predict_rejects_wrong_landmark_count():
response = client.post("/api/predict", json={"landmarks": []})
assert response.status_code == 422
def test_demo_predict():
response = client.post(
"/api/demo/predict",
json={"label": "Help", "confidence": 0.9},
)
assert response.status_code == 200
assert response.json()["status"] == "demo_only"
def test_demo_rejects_unknown_label():
response = client.post(
"/api/demo/predict",
json={"label": "Unknown", "confidence": 0.9},
)
assert response.status_code == 422
def test_homepage_exists():
response = client.get("/")
assert response.status_code in (200, 404)

